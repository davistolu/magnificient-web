# MagnifiScent Platform — Environment Configuration
# Copy this file to .env or configure these variables in your deployment dashboard (e.g. Render, Vercel, Railway, Fly.io)
# CRITICAL: Never commit sensitive credentials or real secrets to version control.

# ==========================================
# 1. DATABASE CONFIGURATION (Neon Serverless PostgreSQL)
# ==========================================
# Connection string with pooled endpoint and sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_DATABASE_PASSWORD@ep-snowy-king-bebstooe-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ==========================================
# 2. SERVER & DEPLOYMENT URLs
# ==========================================
NODE_ENV=production
PORT=5000
# Comma-separated list of allowed origins (supports official domain, apex domain, and local dev)
ALLOWED_ORIGINS=https://magnifiscent.site,https://www.magnifiscent.site,http://localhost:5173
FRONTEND_URL=https://magnifiscent.site
PUBLIC_API_URL=https://api.magnifiscent.site

# ==========================================
# 3. SECURITY & AUTHENTICATION
# ==========================================
JWT_SECRET=replace-with-a-secure-random-32-character-secret-phrase
JWT_EXPIRES_IN=7d

# Initial Admin Seeding Configuration
INITIAL_ADMIN_EMAIL=admin@magnifiscent.site
INITIAL_ADMIN_PASSWORD=replace-with-a-secure-admin-password

# ==========================================
# 4. MEDIA UPLOADS & CLOUD STORAGE (Neon / S3 Bucket / Tigris)
# ==========================================
# When S3 credentials are provided, uploaded images and videos are pushed to your cloud bucket.
# If omitted, uploads default to local storage in ./uploads/
S3_BUCKET_NAME=your-bucket-name
S3_REGION=auto
# Custom endpoint for Neon Tigris, Cloudflare R2, or AWS S3:
S3_ENDPOINT=https://fly.storage.tigris.dev
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# Optional public CDN or bucket URL (e.g. https://cdn.magnifiscent.site or https://pub-xxx.r2.dev)
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# ==========================================
# 5. BRAND & STORE SETTINGS
# ==========================================
STORE_NAME=MagnifiScent
STORE_CURRENCY=NGN
SUPPORT_EMAIL=concierge@magnifiscent.site
WHATSAPP_NUMBER=+2348000000000
MAX_RECEIPT_SIZE_MB=10
