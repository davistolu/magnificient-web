# MagnifiScent Platform — Environment Configuration
# Copy this file to .env in backend/ or set these variables in your deployment dashboard (e.g. Render, Vercel, Railway)

# ==========================================
# 1. DATABASE CONFIGURATION (Neon Serverless Postgres)
# ==========================================
# If DATABASE_URL is not set, the platform will automatically fallback to high-speed SQLite persistence
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/magnifiscent?sslmode=require

# ==========================================
# 2. SERVER & DEPLOYMENT URLs
# ==========================================
NODE_ENV=production
PORT=5000
# Comma-separated list of allowed origins or '*' (supports all *.vercel.app preview URLs automatically)
ALLOWED_ORIGINS=https://magnifiscent.vercel.app,http://localhost:5173
FRONTEND_URL=https://magnifiscent.vercel.app
PUBLIC_API_URL=https://api.magnifiscent.luxury

# ==========================================
# 3. SECURITY & AUTHENTICATION
# ==========================================
JWT_SECRET=magnifiscent-production-super-secret-key-32-chars-min
JWT_EXPIRES_IN=7d

# ==========================================
# 4. MEDIA UPLOADS & CLOUD STORAGE (Neon / S3 Bucket)
# ==========================================
# When S3 credentials are provided, uploaded images and videos are pushed to your cloud bucket.
# If omitted, uploads default to local storage in ./uploads/
S3_BUCKET_NAME=your-bucket-name
S3_REGION=auto
# Custom endpoint for Neon Tigris (e.g. https://fly.storage.tigris.dev), Cloudflare R2, or AWS S3:
S3_ENDPOINT=https://fly.storage.tigris.dev
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# Optional public CDN or bucket URL (e.g. https://cdn.magnifiscent.luxury or https://pub-xxx.r2.dev)
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# ==========================================
# 5. BRAND & STORE SETTINGS
# ==========================================
STORE_NAME=MagnifiScent
STORE_CURRENCY=NGN
SUPPORT_EMAIL=concierge@magnifiscent.luxury
WHATSAPP_NUMBER=+2348000000000
MAX_RECEIPT_SIZE_MB=10
