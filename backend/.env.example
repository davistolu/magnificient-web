# MagnifiScent Backend — Environment Configuration
# Set these variables in your hosting provider (Render, Railway, Fly.io, Vercel Serverless)
# CRITICAL: Never commit sensitive credentials or real secrets to version control.

NODE_ENV=production
PORT=5000

# 1. Database (Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:YOUR_DATABASE_PASSWORD@ep-snowy-king-bebstooe-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# 2. CORS & Client URLs
FRONTEND_URL=https://magnifiscent.site
ALLOWED_ORIGINS=https://magnifiscent.site,https://www.magnifiscent.site,http://localhost:5173
PUBLIC_API_URL=

# 3. Security & Admin Defaults
JWT_SECRET=replace-with-a-secure-random-32-character-secret-phrase
JWT_EXPIRES_IN=7d
INITIAL_ADMIN_EMAIL=admin@magnifiscent.site
INITIAL_ADMIN_PASSWORD=replace-with-a-secure-admin-password

# 4. Neon / S3 Object Storage for Media Uploads (Images, Videos, Receipts)
# Leave blank to use local disk storage in ./uploads/
S3_BUCKET_NAME=
S3_REGION=auto
S3_ENDPOINT=https://fly.storage.tigris.dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# 5. Store Metadata
STORE_NAME=MagnifiScent
STORE_CURRENCY=NGN
SUPPORT_EMAIL=concierge@magnifiscent.site
WHATSAPP_NUMBER=+2348000000000
RECEIPTS_DIR=./uploads/receipts
PRODUCTS_DIR=./uploads/products
MAX_RECEIPT_SIZE_MB=10
