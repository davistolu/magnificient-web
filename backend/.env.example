# MagnifiScent Backend — Environment Configuration
# Set these variables in your hosting provider (Render, Railway, Fly.io, Vercel Serverless)

NODE_ENV=production
PORT=5000

# 1. Database (Neon Serverless PostgreSQL or local PostgreSQL)
# If omitted or offline, the server automatically activates persistent native SQLite storage
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/magnifiscent?sslmode=require

# 2. CORS & Client URLs
FRONTEND_URL=https://magnifiscent.vercel.app
ALLOWED_ORIGINS=https://magnifiscent.vercel.app,http://localhost:5173
PUBLIC_API_URL=https://api.magnifiscent.luxury

# 3. Security
JWT_SECRET=magnifiscent-production-super-secret-key-32-chars-min
JWT_EXPIRES_IN=7d

# 4. Neon / S3 Object Storage for Media Uploads (Images, Videos, Receipts)
# Leave blank to use local disk storage in ./uploads/
S3_BUCKET_NAME=
S3_REGION=auto
S3_ENDPOINT=https://fly.storage.tigris.dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# 5. Store Metadata
STORE_NAME=MagnifiScent
STORE_CURRENCY=NGN
SUPPORT_EMAIL=concierge@magnifiscent.luxury
WHATSAPP_NUMBER=+2348000000000
RECEIPTS_DIR=./uploads/receipts
PRODUCTS_DIR=./uploads/products
MAX_RECEIPT_SIZE_MB=10
