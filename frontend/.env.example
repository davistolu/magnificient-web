# MagnifiScent Frontend — Environment Configuration
# Set these variables in the Vercel Dashboard under Settings > Environment Variables

# 1. Backend API Base URL (e.g. your Render / Railway / Serverless API)
# The frontend automatically appends /api if omitted and trims trailing slashes
VITE_API_URL=https://api.magnifiscent.luxury/api

# 2. Store Front URL (used for 1-click shareable product links in Admin CMS)
# Defaults to window.location.origin in the browser if omitted
VITE_STORE_URL=https://magnifiscent.vercel.app

# 3. Media Base URL (Optional: only needed if backend serves uploads from relative /uploads paths)
# If using S3/Neon buckets, media URLs are already absolute https:// and bypass this setting
VITE_BACKEND_URL=https://api.magnifiscent.luxury

# 4. WhatsApp Luxury Concierge Number (E.164 format with country code)
VITE_WHATSAPP_NUMBER=+2348000000000
