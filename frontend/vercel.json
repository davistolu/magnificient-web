{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://backend-seven-delta-62.vercel.app/api/$1"
    },
    {
      "source": "/products/:slug*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|discordbot|applebot|slackbot|skypeuripreview|whatsapp|googlebot|bingbot|pinterest|redditbot|viber|snapchat|instagram|flipboard|quora|yahoo|vkshare|w3c_validator|embedly|outbrain).*"
        }
      ],
      "destination": "https://backend-seven-delta-62.vercel.app/api/og-preview?slug=:slug*"
    },
    {
      "source": "/:category(watches|jewellery|perfumes|gift-sets|shop)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|discordbot|applebot|slackbot|skypeuripreview|whatsapp|googlebot|bingbot|pinterest|redditbot|viber|snapchat|instagram|flipboard|quora|yahoo|vkshare|w3c_validator|embedly|outbrain).*"
        }
      ],
      "destination": "https://backend-seven-delta-62.vercel.app/api/og-preview?category=:category"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
