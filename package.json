{
  "name": "magnificent-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev": "npm --prefix frontend run dev",
    "test:backend": "npm --prefix backend run test",
    "test": "npm --prefix backend run test",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed"
  },
  "keywords": [
    "luxury",
    "ecommerce",
    "magnificent",
    "watches",
    "jewellery",
    "fragrance"
  ],
  "author": "Magnificent Luxury Retail Ltd",
